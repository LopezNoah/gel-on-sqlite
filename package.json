{
  "name": "sqlite-spec-rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest",
    "build:dist": "node scripts/build-dist.mjs",
    "test:dist": "node scripts/build-dist.mjs && VITEST_USE_DIST=1 vitest run",
    "test:convert-py": "python3 scripts/convert_py_query_test.py",
    "codegen:edgeql-lr": "tsx scripts/generate-gel-lr-spec.ts",
    "db:materialize": "tsx scripts/materialize-test-schema.ts",
    "gel": "tsx bin/gel.ts",
    "codegen:schema-model": "tsx scripts/generate-schema-model.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "ui:preview": "npm --prefix ui run preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "chevrotain": "^13.2.0",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/sql.js": "^1.4.11",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "sql.js": "^1.14.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
